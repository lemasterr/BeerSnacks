# Copy to wrangler.toml for local development (wrangler.toml is gitignored).
# Production bindings are configured in the Cloudflare Pages project settings.
name = "beersnacks"
compatibility_date = "2024-04-05"
pages_build_output_dir = "public"

[[kv_namespaces]]
binding = "DB_KV"
id = "<KV namespace id>"

[[r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "beersnacks-images"

# Secrets (put in .dev.vars locally, and in Pages → Settings → Variables for production):
#   ADMIN_PASSWORD   admin panel password
# Images: product photos live in public/img/products/*.webp (served free as static files).
# Admin uploads go to R2 and are served same-origin from /media/<key>.
